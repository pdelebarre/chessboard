#VRML_SIM R2025a utf8
WorldInfo { basicTimeStep 32 }
Viewpoint { orientation -0.57 0.82 0.24 1.35 position 3.8 -4.4 4.8 }
TexturedBackground { }
TexturedBackgroundLight { }

DEF FLOOR Solid {
  translation 0 0 -0.10
  children [ Shape { appearance PBRAppearance { baseColor 0.12 0.12 0.13 roughness 0.8 } geometry Box { size 5.0 5.0 0.1 } } ]
}

# V0.1 physical baseline: 8 x 0.50 m squares = 4.00 m board in simulation.
DEF BOARD Solid {
  translation 0 0 0
  children [ Shape { appearance PBRAppearance { baseColor 0.76 0.68 0.55 roughness 0.65 } geometry Box { size 4.0 4.0 0.10 } } ]
}

# V0.1 CoreXY rail envelope: 4.40 m nominal rail length, matching the 440 mm real design.
DEF RAIL_X1 Solid { translation 0 -2.18 0.02 children [ Shape { appearance PBRAppearance { baseColor 0.25 0.27 0.30 metalness 0.7 } geometry Box { size 4.4 0.06 0.06 } } ] }
DEF RAIL_X2 Solid { translation 0 2.18 0.02 children [ Shape { appearance PBRAppearance { baseColor 0.25 0.27 0.30 metalness 0.7 } geometry Box { size 4.4 0.06 0.06 } } ] }
DEF RAIL_Y1 Solid { translation -2.18 0 0.02 children [ Shape { appearance PBRAppearance { baseColor 0.25 0.27 0.30 metalness 0.7 } geometry Box { size 0.06 4.4 0.06 } } ] }
DEF RAIL_Y2 Solid { translation 2.18 0 0.02 children [ Shape { appearance PBRAppearance { baseColor 0.25 0.27 0.30 metalness 0.7 } geometry Box { size 0.06 4.4 0.06 } } ] }

# 70 mm carriage and 12 mm target electromagnet, scaled 10:1 from the real V0.1 design.
DEF CARRIAGE Solid {
  translation 0 0 0.08
  children [ Shape { appearance PBRAppearance { baseColor 0.18 0.19 0.21 metalness 0.6 } geometry Box { size 0.70 0.70 0.14 } } ]
}
DEF MAGNET Solid {
  translation 0 0 0.145
  children [
    Shape { appearance PBRAppearance { baseColor 0.10 0.10 0.11 metalness 0.9 } geometry Cylinder { radius 0.06 height 0.04 } }
    PointLight { color 0.95 0.55 0.10 intensity 0.6 radius 0.35 }
  ]
}

# Simplified MVP pieces. The controller demonstrates e2-e4 and e7-e5.
DEF P_E2 Solid {
  translation -0.25 -1.25 0.20
  children [
    Shape { appearance PBRAppearance { baseColor 0.93 0.93 0.90 roughness 0.35 } geometry Cylinder { radius 0.16 height 0.26 } }
    Shape { appearance PBRAppearance { baseColor 0.93 0.93 0.90 roughness 0.35 } geometry Sphere { radius 0.13 } }
  ]
}
DEF P_E7 Solid {
  translation -0.25 1.25 0.20
  children [
    Shape { appearance PBRAppearance { baseColor 0.08 0.08 0.09 roughness 0.35 } geometry Cylinder { radius 0.16 height 0.26 } }
    Shape { appearance PBRAppearance { baseColor 0.08 0.08 0.09 roughness 0.35 } geometry Sphere { radius 0.13 } }
  ]
}

DEF STATUS Solid {
  translation 0 -2.65 0.55
  children [ Shape { appearance PBRAppearance { baseColor 0.18 0.20 0.23 } geometry Box { size 4.2 0.18 0.55 } } ]
}

Robot {
  controller "chessboard_controller"
  supervisor TRUE
}
